//ClassicScore:   Bejeweled3.exe.text+33A6EB: 8B 87 24 0D 00 00 - mov eax,[edi+00000D24]
define(addressClassicScore,Bejeweled3.exe.text+33A6EB)
//define(bytesClassicScore,8B 87 24 0D 00 00)

//PokerScore:   Bejeweled3.exe.text+2DE156: 3B 8D 24 0D 00 00 - cmp ecx,[ebp+00000D24]
