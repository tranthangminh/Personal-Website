//define(bytesZenScore,8B 85 24 0D 00 00)






[ENABLE]

//──────────────────────────────────────── ClassicScore:   Bejeweled3.exe.text+33A6EB: 8B 87 24 0D 00 00 - mov eax,[edi+00000D24]
//assert(addressClassicScore,bytesClassicScore)
alloc(newmemClassicScore,$1000)

alloc(ClassicScore,8)
registersymbol(ClassicScore)

label(codeClassicScore)
label(returnClassicScore)

newmemClassicScore:

codeClassicScore:
  mov [ClassicScore],edi //Save edi address into ClassicScore
  mov eax,[edi+00000D24]
  jmp returnClassicScore

addressClassicScore:
  jmp newmemClassicScore
  nop
returnClassicScore:


//──────────────────────────────────────── PokerScore:   Bejeweled3.exe.text+2DE156: 3B 8D 24 0D 00 00 - cmp ecx,[ebp+00000D24]
