label(returnPokerScore)

newmemPokerScore:

codePokerScore:
  mov [PokerScore],ebp //Save ebp address into PokerScore
  cmp ecx,[ebp+00000D24]
  jmp returnPokerScore

addressPokerScore:
  jmp newmemPokerScore
  nop
returnPokerScore:


