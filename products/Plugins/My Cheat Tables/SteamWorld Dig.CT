[ENABLE]

//──────────────────────────────────────── HP:   SteamWorldDig.exe.text+BA7F1: D9 87 64 01 00 00 - fld dword ptr [edi+00000164]
//assert(addressHP,bytesHP)
alloc(newmemHP,$1000)

alloc(HP,8)
registersymbol(HP)

label(codeHP)
label(returnHP)

newmemHP:

codeHP:
  mov [HP],edi //Save esi address into HP
  fld dword ptr [edi+00000164]
  jmp returnHP

addressHP:
  jmp newmemHP
  nop
returnHP:

//──────────────────────────────────────── Cash:   SteamWorldDig.exe.text+D3C75: 8B 97 E0 04 00 00 - mov edx,[edi+000004E0]
