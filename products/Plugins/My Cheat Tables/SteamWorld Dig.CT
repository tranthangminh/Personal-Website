label(codeTool)
label(returnTool)

newmemTool:

codeTool:
  mov [Tool],eax //Save eax address into Tool
  mov eax,[eax+1C]
  mov esp,ebp
  jmp returnTool

addressTool:
  jmp newmemTool
returnTool:

//──────────────────────────────────────── Depth:   SteamWorldDig.exe.text+D39A9: 39 83 DC 01 00 00 - cmp [ebx+000001DC],eax
//assert(addressDepth,bytesDepth)
alloc(newmemDepth,$1000)

alloc(Depth,8)
