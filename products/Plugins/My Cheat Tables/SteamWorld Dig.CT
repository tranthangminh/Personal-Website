label(codeCash)
label(returnCash)

newmemCash:

codeCash:
  mov [Cash],edi //Save edi address into Cash
  mov edx,[edi+000004E0]
  jmp returnCash

addressCash:
  jmp newmemCash
  nop
returnCash:

