label(codeMoneyOnStart)
label(returnMoneyOnStart)

newmemMoneyOnStart:

codeMoneyOnStart:
  mov eax, [MoneyOnStart] //Load MoneyOnStart value into eax
  mov [DeathSkidMarks++.exe+1C3BC14],eax
  jmp returnMoneyOnStart

MoneyOnStart:
 dd (int)9999

addressMoneyOnStart:
  jmp newmemMoneyOnStart
returnMoneyOnStart:







